# Copy to server/.env and python-service/.env as needed.

# Express API
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/bank2excel
PYTHON_EXTRACTOR_URL=http://127.0.0.1:5001
CLIENT_ORIGIN=http://localhost:5173
MAX_PDF_SIZE_MB=50
UPLOAD_DIR=./uploads

# Python extractor
EXTRACTOR_PORT=5001
